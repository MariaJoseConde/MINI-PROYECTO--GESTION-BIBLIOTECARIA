# GEMINI_API_KEY: Requerido para llamadas de IA generativa (opcional)
GEMINI_API_KEY=""

# APP_URL: URL base de la aplicación
APP_URL="http://localhost:3000"

# SESSION_SECRET: Clave secreta para firma de sesiones HTTP-only
SESSION_SECRET="sgbi-dev-session-secret-change-in-production"

# Configuración de Base de Datos MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sgbi
DB_USERNAME=root
DB_PASSWORD=

# Base de datos SQLite (Modo alternativo/fallback)
DB_PATH="./data/sgbi.db"
